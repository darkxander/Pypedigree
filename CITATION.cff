    family-names: Cliquet
    email: freddy.cliquet@gmail.com
version: 0.4.0
date-released: "2026-11-09"
license: MIT
repository-code: "https://github.com/darkxander/Pypedigree"
url: "https://github.com/darkxander/Pypedigree"
keywords:
